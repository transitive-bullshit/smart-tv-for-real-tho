{
  "name": "smart-tv-for-real-tho",
  "version": "0.0.0",
  "private": true,
  "description": "A personal voice interface for an LG TV and Xbox Series X.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:typecheck": "tsc --noEmit",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "vite build",
    "bridge:sync": "uv sync --frozen --project bridge",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:bridge": "uv run --frozen --project bridge python -m unittest discover -s bridge -p 'test_*.py'",
    "setup:check": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "timings": "tsx scripts/timings.ts",
    "tv:package": "pnpm tv:cli ares-package tv/overlay-probe --outdir build/tv",
    "tv:preview": "vite tv/overlay-probe --host 127.0.0.1 --port 3211 --strictPort",
    "tv:cli": "pnpm --package=@webos-tools/cli@3.2.6 dlx",
    "tv:package-display": "pnpm tv:cli ares-package tv/display --outdir build/tv",
    "tv:preview-display": "vite tv/display --host 127.0.0.1 --port 3213 --strictPort"
  },
  "dependencies": {
    "ky": "^2.0.2",
    "p-map": "^7.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fisch0920/config": "^2.2.0",
    "@fisch0920/oxlint-plugin-anti-slop": "^0.2.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
