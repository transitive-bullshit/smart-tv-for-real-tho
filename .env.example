# Or enter keys in the local operator UI. Never commit real credentials.
OPENAI_API_KEY=
YOUTUBE_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
PORT=3210

# Optional read-only TV activity feed. Set to this Mac’s private LAN IPv4.
TV_DISPLAY_HOST=
TV_DISPLAY_PORT=3212
## Ambient uploader only; never bundled in the TV/browser client.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=auto
S3_PUBLIC_URL=
